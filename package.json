{
  "name": "modern-cv-builder",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:app": "vite",
    "start": "node scripts/dev-local.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "pnpm build && wrangler pages dev dist/analog/public",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy:prod": "pnpm build && pnpm deploy:pages && pnpm deploy:worker",
    "deploy:pages": "wrangler pages deploy dist/analog/public --project-name=cv-builder --branch=main",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:preview": "pnpm build && wrangler pages deploy dist/analog/public --project-name=cv-builder"
  },
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@voltui/components": "0.6.0",
    "angular-movement": "0.5.0",
    "dexie": "4.3.0",
    "html-to-image": "1.11.13",
    "jspdf": "2.5.2",
    "lumen-icons": "0.2.0",
    "quartz-headless": "0.0.3",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/content": "2.7.0",
    "@analogjs/platform": "2.7.0",
    "@analogjs/router": "2.7.0",
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@analogjs/vitest-angular": "2.7.0",
    "@angular/build": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@cloudflare/puppeteer": "^1.2.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
