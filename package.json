{
  "name": "modern-cv-builder",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "pnpm build && wrangler pages dev dist/analog/public",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy:prod": "pnpm build && pnpm deploy:pages && pnpm deploy:worker",
    "deploy:pages": "wrangler pages deploy dist/analog/public --project-name=cv-builder --branch=main",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:preview": "pnpm build && wrangler pages deploy dist/analog/public --project-name=cv-builder"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@tailwindcss/postcss": "^4.1.11",
    "@voltui/components": "0.6.0",
    "angular-movement": "0.5.0",
    "dexie": "4.3.0",
    "html-to-image": "1.11.13",
    "jspdf": "2.5.2",
    "lumen-icons": "0.2.0",
    "quartz-headless": "0.0.3",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/content": "2.6.3",
    "@analogjs/platform": "2.6.3",
    "@analogjs/router": "2.6.3",
    "@angular/build": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@cloudflare/puppeteer": "^1.2.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.114.0"
  }
}
